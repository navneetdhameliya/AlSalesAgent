ENVIRONMENT=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Use secrets of at least 32 characters in production
SUPABASE_JWT_SECRET=
WIDGET_SESSION_SECRET=
LEAD_WEBHOOK_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
BUSINESS_NAME=Your Company
PERSONA_NAME=Aisha
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CORS_ORIGINS=http://localhost:3000
UNSUBSCRIBE_SIGNING_KEY=
# Email (Resend assumed; the provider sits behind app/channels/email.py)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_NAME=Your Company
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=
# Follow-ups: the scheduler loop runs inside the API process when enabled
SCHEDULER_ENABLED=true
BUSINESS_TIMEZONE=Asia/Kolkata
FOLLOWUP_WINDOW_START=9
FOLLOWUP_WINDOW_END=19
API_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
DEFAULT_COUNTRY_CODE=91
# Supabase Auth admin (used only to invite team members from Settings; server-side secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
